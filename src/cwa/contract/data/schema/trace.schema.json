{
  "type": "object",
  "properties": {
    "trace_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "[^\\t\\n\\v\\f\\r \\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff]"
    },
    "profile": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "[^\\t\\n\\v\\f\\r \\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff]"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "budget": {
      "type": "object",
      "properties": {
        "input": {
          "type": "integer",
          "minimum": 0
        },
        "reserved_output": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "input",
        "reserved_output"
      ],
      "additionalProperties": false
    },
    "result": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "input_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "hash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "input_tokens",
            "hash"
          ],
          "additionalProperties": false
        }
      ]
    },
    "included": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "slot": {
            "type": "string",
            "enum": [
              "governance.instructions",
              "governance.capabilities",
              "governance.examples",
              "governance.output_contract",
              "state.user",
              "state.task",
              "evidence.knowledge",
              "evidence.tool_results",
              "interaction.memory",
              "interaction.history",
              "interaction.query"
            ]
          },
          "item_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "[^\\t\\n\\v\\f\\r \\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff]"
          },
          "tokens": {
            "type": "integer",
            "minimum": 0
          },
          "source_version": {
            "type": "string",
            "minLength": 1,
            "pattern": "[^\\t\\n\\v\\f\\r \\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff]"
          },
          "eligibility": {
            "type": "string",
            "minLength": 1,
            "pattern": "[^\\t\\n\\v\\f\\r \\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff]"
          }
        },
        "required": [
          "slot",
          "item_id",
          "tokens"
        ],
        "additionalProperties": false
      }
    },
    "compressed": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "slot": {
            "type": "string",
            "enum": [
              "governance.instructions",
              "governance.capabilities",
              "governance.examples",
              "governance.output_contract",
              "state.user",
              "state.task",
              "evidence.knowledge",
              "evidence.tool_results",
              "interaction.memory",
              "interaction.history",
              "interaction.query"
            ]
          },
          "item_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "[^\\t\\n\\v\\f\\r \\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff]"
          },
          "from": {
            "type": "integer",
            "minimum": 0
          },
          "to": {
            "type": "integer",
            "minimum": 0
          },
          "method": {
            "type": "string",
            "minLength": 1,
            "pattern": "[^\\t\\n\\v\\f\\r \\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff]"
          },
          "variant_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "[^\\t\\n\\v\\f\\r \\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff]"
          }
        },
        "required": [
          "slot",
          "item_id",
          "from",
          "to",
          "method",
          "variant_id"
        ],
        "additionalProperties": false
      }
    },
    "excluded": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "[^\\t\\n\\v\\f\\r \\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff]"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "pattern": "[^\\t\\n\\v\\f\\r \\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff]"
          },
          "stage": {
            "type": "string",
            "enum": [
              "producer",
              "assembler"
            ]
          },
          "slot": {
            "type": "string",
            "enum": [
              "governance.instructions",
              "governance.capabilities",
              "governance.examples",
              "governance.output_contract",
              "state.user",
              "state.task",
              "evidence.knowledge",
              "evidence.tool_results",
              "interaction.memory",
              "interaction.history",
              "interaction.query"
            ]
          }
        },
        "required": [
          "item_id",
          "reason",
          "stage"
        ],
        "additionalProperties": false
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "[^\\t\\n\\v\\f\\r \\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff]"
            },
            "minItems": 2,
            "uniqueItems": true
          },
          "kind": {
            "type": "string",
            "enum": [
              "instruction",
              "fact"
            ]
          },
          "resolution": {
            "type": "string",
            "enum": [
              "resolved",
              "surfaced",
              "context_requested",
              "refused",
              "moot"
            ],
            "description": "resolved when authority or policy decided the group; surfaced, context_requested or refused when it escalated, following the route's on_unresolved action; moot when fewer than two members were admitted (R-11)."
          },
          "decided_by": {
            "type": "string",
            "enum": [
              "authority",
              "policy",
              "freshness",
              "escalated",
              "moot"
            ]
          },
          "group_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "[^\\t\\n\\v\\f\\r \\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff]"
          },
          "winner": {
            "type": "string",
            "minLength": 1,
            "pattern": "[^\\t\\n\\v\\f\\r \\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff]",
            "description": "The member that prevailed, when one did. One of items."
          }
        },
        "required": [
          "items",
          "kind",
          "resolution",
          "decided_by"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "type": "object",
              "properties": {
                "decided_by": {
                  "const": "moot"
                }
              },
              "required": [
                "decided_by"
              ]
            },
            "then": {
              "type": "object",
              "properties": {
                "resolution": {
                  "const": "moot"
                }
              }
            },
            "else": {
              "type": "object",
              "properties": {
                "resolution": {
                  "not": {
                    "const": "moot"
                  }
                }
              }
            }
          },
          {
            "if": {
              "type": "object",
              "properties": {
                "decided_by": {
                  "const": "escalated"
                }
              },
              "required": [
                "decided_by"
              ]
            },
            "then": {
              "type": "object",
              "properties": {
                "resolution": {
                  "enum": [
                    "surfaced",
                    "context_requested",
                    "refused"
                  ]
                }
              }
            },
            "else": {
              "type": "object",
              "properties": {
                "resolution": {
                  "not": {
                    "enum": [
                      "surfaced",
                      "context_requested",
                      "refused"
                    ]
                  }
                }
              }
            }
          },
          {
            "if": {
              "type": "object",
              "required": [
                "winner"
              ],
              "properties": {
                "winner": true
              }
            },
            "then": {
              "type": "object",
              "properties": {
                "resolution": {
                  "const": "resolved"
                }
              }
            }
          }
        ]
      }
    },
    "refused": {
      "type": "object",
      "properties": {
        "bool": {
          "type": "boolean"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "[^\\t\\n\\v\\f\\r \\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff]"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "bool",
        "reason"
      ],
      "additionalProperties": false
    },
    "context": {
      "type": "object",
      "properties": {
        "assembly_time": {
          "type": "string",
          "format": "date-time"
        },
        "route_policy_version": {
          "type": "string",
          "minLength": 1,
          "pattern": "[^\\t\\n\\v\\f\\r \\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff]"
        },
        "tokenizer": {
          "type": "string",
          "minLength": 1,
          "pattern": "[^\\t\\n\\v\\f\\r \\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff]"
        },
        "renderer": {
          "type": "string",
          "minLength": 1,
          "pattern": "[^\\t\\n\\v\\f\\r \\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff]"
        },
        "snapshot_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "assembly_time",
        "route_policy_version",
        "tokenizer",
        "renderer"
      ],
      "additionalProperties": false
    },
    "defaults_filled": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "[^\\t\\n\\v\\f\\r \\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff]"
          },
          "field": {
            "type": "string",
            "enum": [
              "token_budget",
              "variants",
              "conflict_policy",
              "lineage",
              "eligibility",
              "injection_risk"
            ]
          }
        },
        "required": [
          "item_id",
          "field"
        ],
        "additionalProperties": false
      }
    },
    "timings": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0
      }
    },
    "recovery": {
      "type": "object",
      "properties": {
        "action": {
          "enum": [
            "retrieve_narrower",
            "precompute_summary",
            "request_context"
          ]
        },
        "detail": {
          "type": "string"
        }
      },
      "required": [
        "action"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "trace_id",
    "profile",
    "budget",
    "result",
    "included",
    "compressed",
    "excluded",
    "conflicts",
    "refused",
    "context"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contextwindowarchitecture.io/schema/trace.schema.json",
  "title": "CWA assembly trace",
  "allOf": [
    {
      "if": {
        "properties": {
          "refused": {
            "properties": {
              "bool": {
                "const": true
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      },
      "then": {
        "properties": {
          "result": {
            "type": "null"
          },
          "refused": {
            "properties": {
              "reason": {
                "type": "string",
                "minLength": 1,
                "pattern": "[^\\t\\n\\v\\f\\r \\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff]"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      },
      "else": {
        "properties": {
          "result": {
            "type": "object"
          },
          "refused": {
            "properties": {
              "reason": {
                "type": "null"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      }
    },
    {
      "if": {
        "properties": {
          "refused": {
            "type": "object",
            "properties": {
              "reason": {
                "const": "evidence_required"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "recovery": {
            "type": "object",
            "properties": {
              "action": {
                "enum": [
                  "retrieve_narrower",
                  "precompute_summary",
                  "request_context"
                ]
              },
              "detail": {
                "type": "string"
              }
            },
            "required": [
              "action"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "recovery"
        ]
      }
    }
  ]
}
