{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contextwindowarchitecture.io/schema/conflict_group.schema.json",
  "title": "CWA conflict group",
  "description": "An application-declared conflict among items. The assembler resolves declared groups; it never discovers contradictions by interpreting prose.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "items"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "kind": {
      "type": "string",
      "enum": [
        "instruction",
        "fact"
      ]
    },
    "fact": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Route-policy key identifying the fact in dispute; required for fact groups."
    },
    "items": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 2,
      "uniqueItems": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "fact"
          }
        }
      },
      "then": {
        "required": [
          "fact"
        ],
        "properties": {
          "fact": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    }
  ]
}
