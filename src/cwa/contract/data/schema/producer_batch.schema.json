{
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "$ref": "https://contextwindowarchitecture.io/schema/context_item.schema.json"
      }
    },
    "excluded": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "[^\\t\\n\\v\\f\\r \\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff]"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "pattern": "[^\\t\\n\\v\\f\\r \\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff]"
          },
          "stage": {
            "const": "producer"
          },
          "duplicate_of": {
            "type": "string",
            "minLength": 1,
            "pattern": "[^\\t\\n\\v\\f\\r \\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff]",
            "description": "For duplicate_content only: the id of the candidate in this batch the producer kept in the dropped item's place (R-13)."
          }
        },
        "required": [
          "item_id",
          "reason",
          "stage"
        ],
        "additionalProperties": false,
        "if": {
          "properties": {
            "reason": {
              "const": "duplicate_content"
            }
          },
          "required": [
            "reason"
          ]
        },
        "then": {
          "required": [
            "duplicate_of"
          ],
          "properties": {
            "duplicate_of": true
          }
        },
        "else": {
          "not": {
            "required": [
              "duplicate_of"
            ],
            "properties": {
              "duplicate_of": true
            }
          }
        }
      }
    }
  },
  "required": [
    "items",
    "excluded"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contextwindowarchitecture.io/schema/producer_batch.schema.json",
  "title": "CWA producer handoff"
}
